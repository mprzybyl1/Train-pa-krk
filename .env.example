# --- PKP PLK, Otwarte Dane Kolejowe (https://pdp-api.plk-sa.pl) ---
PLK_API_KEY=sk_live_wpisz_swoj_klucz
# Co ile sekund pobierać realizację (opóźnienia). Basic: 1000 zapytań/dobę -> min. ~120 s.
# Ze Standard (5000/dobę) można zejść do 60.
PLK_POLL_SECONDS=120
# Co ile godzin odświeżać rozkład (2 zapytania). Dodatkowo zawsze po zmianie daty.
PLK_SCHEDULE_REFRESH_HOURS=12
# Przerwa nocna bez zapytań o realizację (HH:MM-HH:MM, czas warszawski). Puste = brak przerwy.
PLK_QUIET_HOURS=01:00-04:30

# ID stacji PLK (z danych OSM/PolishTrainsGTFS; do potwierdzenia: python -m app.capture)
STATION_POZNAN_ID=30601
STATION_KRAKOW_ID=80416
# Ile godzin naprzód pokazywać
WINDOW_HOURS=4

# Tryb demo: zmyślone dane bez klucza API, do podglądu interfejsu
DEMO_MODE=false

# --- Faza 2: Web Push. Klucze: docker compose run --rm app python -m app.gen_vapid ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ty@example.com
# O ile minut musi zmienić się opóźnienie, żeby wysłać powiadomienie
PUSH_DELAY_THRESHOLD=5

LOG_LEVEL=INFO
